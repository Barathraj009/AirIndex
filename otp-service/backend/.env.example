# ============================================================
# Gmail OTP Authentication Module — Environment Configuration
# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file to version control.
# ============================================================

# ---- Server ----
PORT=4000
NODE_ENV=development
# Comma-separated list of origins allowed to call this API (your frontend URL(s))
CORS_ORIGIN=http://localhost:4000,http://localhost:5173
# Set only when running behind a reverse proxy / load balancer so the
# per-IP rate limiters see the real client IP. Values: true, false, a
# hop count ("1"), or an express proxy pattern ("loopback", "10.0.0.1").
# See https://expressjs.com/en/guide/behind-proxies.html
TRUST_PROXY=false

# ---- App branding (used in emails / UI hand-off) ----
APP_NAME=Your Application

# ---- Gmail SMTP credentials ----
# Use a Google "App Password", NOT your real Gmail password.
# Create one at: https://myaccount.google.com/apppasswords
# (Requires 2-Step Verification to be enabled on the Gmail account.)
GMAIL_USER=your-sending-address@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Email transport. "gmail" = real delivery via Gmail SMTP above.
# "json" = offline convenience transport (renders the email into memory,
# never sends). Forcing NODE_ENV=test also forces json. Never use json in
# production.
EMAIL_TRANSPORT=gmail

# ---- Email address policy ----
# If true, only @gmail.com / @googlemail.com addresses are accepted.
GMAIL_ONLY=true

# ---- OTP behavior ----
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
# Minimum seconds a user must wait between OTP requests for the same email
OTP_RESEND_COOLDOWN_SECONDS=45
# Max OTP requests allowed per email within the rolling window below
OTP_MAX_REQUESTS_PER_WINDOW=5
OTP_REQUEST_WINDOW_MINUTES=15

# ---- Secrets ----
# Used to HMAC-hash OTPs before storing them (never store plain OTPs).
# Generate: openssl rand -hex 32
OTP_HASH_SECRET=change-this-to-a-long-random-string

# Used to sign session JWTs issued after successful verification. Use a
# DIFFERENT long random string. The host application shares this secret
# when it verifies the hand-off token itself (instead of calling /session).
# Generate: openssl rand -hex 32
JWT_SECRET=change-this-to-a-different-long-random-string
JWT_EXPIRES_IN=15m

# ---- Session cookie ----
# If true, the session token is also set as an httpOnly cookie.
USE_COOKIE_SESSION=true
COOKIE_NAME=otp_auth_session
# "lax" (works for the demo / same-origin), "strict", or "none"
# (cross-origin API clients; requires HTTPS so the cookie is Secure).
COOKIE_SAMESITE=lax