# AirIndex India — environment configuration template
# Copy to .env and fill in real values. Never commit the real .env file.

# --- Database ---
DATABASE_URL=postgresql+psycopg2://airindex:changeme@localhost:5432/airindex
POSTGRES_USER=airindex
POSTGRES_PASSWORD=changeme
POSTGRES_DB=airindex

# --- Auth ---
JWT_SECRET_KEY=replace-with-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Seed ---
# Seed script admin bootstrap. Defaults: admin@airindex.gov.in /
# change-me-immediately (valid only for local demo; SET THESE for any
# non-local environment). The seed prints a loud reminder otherwise.
SEED_ADMIN_EMAIL=admin@airindex.gov.in
SEED_ADMIN_PASSWORD=change-me-immediately

# --- App ---
ENVIRONMENT=development   # development | staging | production
CORS_ALLOWED_ORIGINS=http://localhost:5173   # comma-separated; add :4173 (vite preview) or any new UI origin
API_RATE_LIMIT_PER_MINUTE=120

# --- Scheduling ---
INGESTION_SCHEDULE_CRON=0 */6 * * *   # every 6 hours

# --- Scraping / ingestion ---
SCRAPER_USER_AGENT=AirIndexIndiaBot/1.0 (+https://example.gov.in/airindex; contact: data-team@example.gov.in)
SCRAPER_MIN_DELAY_SECONDS=5

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000/api
