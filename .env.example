# AirIndex India — environment configuration template
# Copy to .env and fill in real values. Never commit the real .env file.

# --- Database ---
DATABASE_URL=postgresql+psycopg2://airindex:changeme@localhost:5432/airindex
POSTGRES_USER=airindex
POSTGRES_PASSWORD=changeme
POSTGRES_DB=airindex

# --- Auth ---
JWT_SECRET_KEY=replace-with-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- OTP service ---
# JWT secret shared with the otp-service (email OTP auth). Required in
# production; the app refuses to start with the placeholder value there.
OTP_SERVICE_JWT_SECRET=dev-otp-jwt-secret-change-in-prod

# --- Seed ---
# Seed script admin bootstrap. Defaults: admin@airindex.gov.in /
# change-me-immediately (valid only for local demo; SET THESE for any
# non-local environment). The seed prints a loud reminder otherwise.
SEED_ADMIN_EMAIL=admin@airindex.gov.in
SEED_ADMIN_PASSWORD=change-me-immediately

# --- App ---
ENVIRONMENT=development   # development | staging | production
CORS_ALLOWED_ORIGINS=http://localhost:5173   # comma-separated; add :4173 (vite preview) or any new UI origin
API_RATE_LIMIT_PER_MINUTE=120

# --- Scheduling ---
# Cadence for the scheduled ingestion job (all active sources). The
# Google Flights feed makes one RapidAPI request per active route per
# run: daily (default) ≈ 6 requests/day ≈ 180/month on the Basic $0
# plan; weekly = ~24/month. Set to suit your quota.
INGESTION_SCHEDULE_CRON=0 6 * * *   # daily 06:00 UTC
# INGESTION_SCHEDULE_CRON=0 6 * * 1  # weekly (Mon 06:00 UTC)

# --- Scraping / ingestion ---
SCRAPER_USER_AGENT=AirIndexIndiaBot/1.0 (+https://example.gov.in/airindex; contact: data-team@example.gov.in)
SCRAPER_MIN_DELAY_SECONDS=5
# Web-scraper framework (11 sources: IndiGo, Air India, AI Express, Akasa,
# SpiceJet, MakeMyTrip, Yatra, EaseMyTrip, Cleartrip, ixigo, Goibibo).
# No API keys are needed: every source is currently UNAVAILABLE by
# compliance decision (robots.txt/ToS), the adapters re-check robots.txt
# fail-closed at runtime, and the daily 06:30 UTC compliance job logs
# verdicts to scraper_errors. A partner fare API would be added per-source.
# The demo fallback is DEMO_GENERATOR (clearly labeled DEMO_SIMULATED).
# RapidAPI key for the Google Flights fare adapter (gds_adapter).
# Subscribe to the "Google Flights" API by Crawlio on RapidAPI (host
# google-flights8.p.rapidapi.com, Basic $0 plan) and paste your key here.
RAPIDAPI_KEY=
# google-flights8 returns calendar prices in USD only, regardless of the
# currency request parameter. The live adapter converts to INR at this
# reference rate (a constant FX factor cancels out in day-over-day index
# arithmetic, so the index/change analysis is unaffected by the choice).
FX_RATE_USD_INR=90.0
# Kiwi.com Tequila flights adapter key (kiwi_adapter).
KIWI_API_KEY=

# --- Surge alert notifications (optional) ---
# ALERT_ENABLED=true
# ALERT_THRESHOLD_PCT=10.0
# ALERT_COOLDOWN_HOURS=24
# ALERT_SMTP_HOST=localhost
# ALERT_SMTP_PORT=587
# ALERT_SMTP_USER=
# ALERT_SMTP_PASSWORD=
# ALERT_FROM_EMAIL=airindex-alerts@example.com
# ALERT_TO_EMAILS=ops@example.com
# ALERT_WEBHOOK_URL=

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000/api
